PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/cortex
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# --- AI Configuration ---
# OPTION A: Google Gemini API (Recommended for Cloud/Free deployment - No local RAM needed!)
# Just set your free GEMINI_API_KEY from https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSy...
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-2
# GEMINI_EMBED_DIMENSIONS=768

# OPTION B: Local Ollama (Used automatically when GEMINI_API_KEY is not set)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=all-minilm

STORAGE_DIR=../../storage

# Maximum requests per IP per minute. Separate per-account upload and AI limits also apply.
API_RATE_LIMIT=240
# Maximum concurrent chat, quiz and study generations across API instances.
AI_CONCURRENCY=5
# Maximum simultaneous embedding calls across API instances and workers.
EMBEDDING_CONCURRENCY=5
