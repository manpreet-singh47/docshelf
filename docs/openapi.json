        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "description": "PDF, DOCX, TXT, Markdown; maximum 10 MB. Processing is asynchronous. DOCX sources are document-level because rendered Word page numbers are unavailable."
