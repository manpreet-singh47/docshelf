  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Auth": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "ready",
              "failed"
            ]
          },
          "size": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Collection": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "name": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "number"
          },
          "ready": {
            "type": "number"
          },
          "storageBytes": {
            "type": "number"
          },
          "storageLimit": {
            "type": "number"
          },
          "conversations": {
            "type": "number"
          },
          "quizzes": {
            "type": "number"
          },
          "materials": {
            "type": "number"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "document": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{24}$"
                },
                "name": {
                  "type": "string"
                },
                "page": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                }
              }
            }
          },
          "limited": {
            "type": "boolean"
          }
        }
      }
    }
  }
